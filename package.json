{
  "name": "projectsurvey",
  "version": "1.0.0",
  "description": "这是一个monorepo 环境调研项目",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "pnpm --filter project1-vue3 dev",
    "build": "pnpm --filter project1-vue3 build",
    "preview": "pnpm --filter project1-vue3 preview",
    "dev:2": "pnpm --filter project2-vue3 dev",
    "build:2": "pnpm --filter project2-vue3 build",
    "preview:2": "pnpm --filter project2-vue3 preview",
    "dev:3": "pnpm --filter project3-react dev",
    "build:packages": "node ./scripts/build.js",
    "lint:prettier": "prettier --write \"**/*.{js,ts,mjs,cjs,json,tsx,css,less,scss,vue,html,md}\""
  },
  "engines": {
    "node": ">=20.19.6",
    "npm": ">=10.8.2",
    "pnpm": ">=10.26.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/tsconfig": "^0.8.1",
    "prettier": "^3.7.4",
    "rollup": "^4.55.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  },
  "dependencies": {
    "@project-survey/ui": "workspace:*",
    "@project-survey/utils": "workspace:*",
    "vue": "^3.5.24"
  }
}
